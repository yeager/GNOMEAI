From bf64ce966c342577f573e86f02ab87955f2131fa Mon Sep 17 00:00:00 2001
From: Daniel Nylander <yeager@users.noreply.gitlab.gnome.org>
Date: Fri, 11 Sep 2026 23:17:43 +0200
Subject: [PATCH 1/3] app/widgets: update exact samples at one position

---
 app/widgets/gimpcolorframe.c | 23 ++++++++++++++++++-----
 1 file changed, 18 insertions(+), 5 deletions(-)

diff --git a/app/widgets/gimpcolorframe.c b/app/widgets/gimpcolorframe.c
index 6bd0d2e02f..815803d666 100644
--- a/app/widgets/gimpcolorframe.c
+++ b/app/widgets/gimpcolorframe.c
@@ -617,12 +617,25 @@ gimp_color_frame_set_color (GimpColorFrame *frame,
       frame->sample_average                == sample_average                &&
       frame->x                             == x                             &&
       frame->y                             == y                             &&
-      gegl_color_get_format (frame->color) == gegl_color_get_format (color) &&
-      gimp_color_is_perceptually_identical (frame->color, color))
+      gegl_color_get_format (frame->color) == gegl_color_get_format (color))
     {
-      g_clear_object (&frame->color);
-      frame->color = color;
-      return;
+      gdouble old_rgba[4];
+      gdouble new_rgba[4];
+
+      gegl_color_get_rgba (frame->color,
+                            &old_rgba[0], &old_rgba[1],
+                            &old_rgba[2], &old_rgba[3]);
+      gegl_color_get_rgba (color,
+                            &new_rgba[0], &new_rgba[1],
+                            &new_rgba[2], &new_rgba[3]);
+
+      if (old_rgba[0] == new_rgba[0] && old_rgba[1] == new_rgba[1] &&
+          old_rgba[2] == new_rgba[2] && old_rgba[3] == new_rgba[3])
+        {
+          g_clear_object (&frame->color);
+          frame->color = color;
+          return;
+        }
     }
 
   frame->sample_valid   = TRUE;
-- 
