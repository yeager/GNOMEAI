From 2d86633d8140226e7f1cb50d368148f1b2f8c5bc Mon Sep 17 00:00:00 2001
From: Daniel Nylander <po@danielnylander.se>
Date: Mon, 23 Nov 2026 13:53:53 +0100
Subject: [PATCH] Localize generic UCM audio port labels

---
 gvc-mixer-control.c      | 23 ++++++++++++++++++++++-
 gvc-port-label-private.h | 34 ++++++++++++++++++++++++++++++++++
 meson.build              |  6 ++++++
 test-port-label.c        | 23 +++++++++++++++++++++++
 4 files changed, 85 insertions(+), 1 deletion(-)
 create mode 100644 gvc-port-label-private.h
 create mode 100644 test-port-label.c

diff --git a/gvc-mixer-control.c b/gvc-mixer-control.c
index 099b8d9..bca809d 100644
--- a/gvc-mixer-control.c
+++ b/gvc-mixer-control.c
@@ -45,6 +45,7 @@
 #include "gvc-mixer-source-output.h"
 #include "gvc-mixer-event-role.h"
 #include "gvc-mixer-card.h"
+#include "gvc-port-label-private.h"
 #include "gvc-mixer-card-private.h"
 #include "gvc-channel-map-private.h"
 #include "gvc-mixer-control-private.h"
@@ -2691,7 +2692,27 @@ update_card (GvcMixerControl      *control,
 
                         card_port = g_new0 (GvcMixerCardPort, 1);
                         card_port->port = g_strdup (port->name);
-                        card_port->human_port = g_strdup (port->description);
+                        switch (gvc_port_label_classify (port->name,
+                                                         port->description,
+#if PA_PROTOCOL_VERSION >= 34
+                                                         port->type
+#else
+                                                         0
+#endif
+                                                         )) {
+                        case GVC_PORT_LABEL_SPEAKER:
+                                /* Translators: generic audio output port label. */
+                                card_port->human_port = g_strdup (_("Speaker"));
+                                break;
+                        case GVC_PORT_LABEL_HEADPHONES:
+                                /* Translators: generic audio output port label. */
+                                card_port->human_port = g_strdup (_("Headphones"));
+                                break;
+                        case GVC_PORT_LABEL_UNCHANGED:
+                        default:
+                                card_port->human_port = g_strdup (port->description);
+                                break;
+                        }
                         card_port->priority = port->priority;
                         card_port->available = port->available;
                         card_port->direction = port->direction;
diff --git a/gvc-port-label-private.h b/gvc-port-label-private.h
new file mode 100644
index 0000000..7c1d74c
--- /dev/null
+++ b/gvc-port-label-private.h
@@ -0,0 +1,34 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <glib.h>
+#include <pulse/pulseaudio.h>
+
+typedef enum {
+        GVC_PORT_LABEL_UNCHANGED,
+        GVC_PORT_LABEL_SPEAKER,
+        GVC_PORT_LABEL_HEADPHONES,
+} GvcPortLabel;
+
+/* Only translate exact generic UCM labels with the matching port type and
+ * identity. Keep custom descriptions and device identifiers unchanged. */
+static inline GvcPortLabel
+gvc_port_label_classify (const char *name, const char *description,
+                         int type)
+{
+#if PA_PROTOCOL_VERSION >= 34
+        if (type == PA_DEVICE_PORT_TYPE_SPEAKER &&
+            g_strcmp0 (name, "[Out] Speaker") == 0 &&
+            g_strcmp0 (description, "Speaker") == 0)
+                return GVC_PORT_LABEL_SPEAKER;
+        if (type == PA_DEVICE_PORT_TYPE_HEADPHONES &&
+            g_strcmp0 (name, "[Out] Headphones") == 0 &&
+            g_strcmp0 (description, "Headphones") == 0)
+                return GVC_PORT_LABEL_HEADPHONES;
+#else
+        (void) name;
+        (void) description;
+        (void) type;
+#endif
+        return GVC_PORT_LABEL_UNCHANGED;
+}
diff --git a/meson.build b/meson.build
index a1a2af5..d09337c 100644
--- a/meson.build
+++ b/meson.build
@@ -135,3 +135,9 @@ configure_file(
   output: 'config.h',
   configuration: cdata
 )
+
+port_label_test = executable('test-port-label',
+  sources: 'test-port-label.c',
+  dependencies: libgvc_deps
+)
+test('port-label', port_label_test)
diff --git a/test-port-label.c b/test-port-label.c
new file mode 100644
index 0000000..72dbb96
--- /dev/null
+++ b/test-port-label.c
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <glib.h>
+#include "gvc-port-label-private.h"
+
+static void test_port_labels (void)
+{
+#if PA_PROTOCOL_VERSION >= 34
+        g_assert_cmpint (gvc_port_label_classify ("[Out] Speaker", "Speaker", PA_DEVICE_PORT_TYPE_SPEAKER), ==, GVC_PORT_LABEL_SPEAKER);
+        g_assert_cmpint (gvc_port_label_classify ("[Out] Headphones", "Headphones", PA_DEVICE_PORT_TYPE_HEADPHONES), ==, GVC_PORT_LABEL_HEADPHONES);
+        g_assert_cmpint (gvc_port_label_classify ("[Out] Speaker", "Bass Speaker", PA_DEVICE_PORT_TYPE_SPEAKER), ==, GVC_PORT_LABEL_UNCHANGED);
+        g_assert_cmpint (gvc_port_label_classify ("[Out] Speaker", "Speaker", PA_DEVICE_PORT_TYPE_HEADPHONES), ==, GVC_PORT_LABEL_UNCHANGED);
+        g_assert_cmpint (gvc_port_label_classify ("[Out] Speaker2", "Speaker", PA_DEVICE_PORT_TYPE_SPEAKER), ==, GVC_PORT_LABEL_UNCHANGED);
+        g_assert_cmpint (gvc_port_label_classify ("[In] Mic1", "Digital Microphone", PA_DEVICE_PORT_TYPE_MIC), ==, GVC_PORT_LABEL_UNCHANGED);
+        g_assert_cmpint (gvc_port_label_classify (NULL, NULL, PA_DEVICE_PORT_TYPE_UNKNOWN), ==, GVC_PORT_LABEL_UNCHANGED);
+#endif
+}
+
+int main (int argc, char **argv)
+{
+        g_test_init (&argc, &argv, NULL);
+        g_test_add_func ("/gvc/port-label/classify", test_port_labels);
+        return g_test_run ();
+}
-- 
