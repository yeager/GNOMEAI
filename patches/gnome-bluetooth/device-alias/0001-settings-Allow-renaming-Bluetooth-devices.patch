From 013c561a3f3695b5e4c4cd0245b89c5a262c9d29 Mon Sep 17 00:00:00 2001
From: yeager <yeager@users.noreply.github.com>
Date: Sat, 12 Sep 2026 14:04:40 +0200
Subject: [PATCH] settings: Allow renaming Bluetooth devices

---
 lib/bluetooth-settings-widget.c | 55 +++++++++++++++++++++++++++++++++
 lib/settings.ui                 | 17 ++++++++++
 tests/integration-test.py       | 21 +++++++++++++
 3 files changed, 93 insertions(+)

diff --git a/lib/bluetooth-settings-widget.c b/lib/bluetooth-settings-widget.c
index 3326ff1..ae3be43 100644
--- a/lib/bluetooth-settings-widget.c
+++ b/lib/bluetooth-settings-widget.c
@@ -1080,6 +1080,58 @@ switch_connected_state_set (GtkSwitch               *button,
 	return TRUE;
 }
 
+static void
+set_device_alias_done (GObject      *source,
+                       GAsyncResult *result,
+                       gpointer      user_data)
+{
+	g_autoptr(GError) error = NULL;
+	g_autoptr(GVariant) reply = NULL;
+
+	reply = g_dbus_connection_call_finish (G_DBUS_CONNECTION (source), result, &error);
+	if (error != NULL)
+		g_warning ("Could not update Bluetooth device name: %s", error->message);
+}
+
+static void
+save_device_alias (GtkButton               *button,
+                   BluetoothSettingsWidget *self)
+{
+	g_autoptr(GDBusConnection) connection = NULL;
+	g_autoptr(GError) error = NULL;
+	const char *alias;
+
+	if (self->selected_object_path == NULL)
+		return;
+
+	alias = gtk_editable_get_text (GTK_EDITABLE (WID ("device_alias")));
+	if (alias == NULL || *alias == '\0')
+		return;
+
+	connection = g_bus_get_sync (G_BUS_TYPE_SYSTEM, self->cancellable, &error);
+	if (connection == NULL) {
+		g_warning ("Could not connect to BlueZ: %s", error->message);
+		return;
+	}
+
+	g_dbus_connection_call (connection,
+	                        BLUEZ_SERVICE,
+	                        self->selected_object_path,
+	                        "org.freedesktop.DBus.Properties",
+	                        "Set",
+	                        g_variant_new ("(ssv)",
+	                                       "org.bluez.Device1",
+	                                       "Alias",
+	                                       g_variant_new_string (alias)),
+	                        NULL,
+	                        G_DBUS_CALL_FLAGS_NONE,
+	                        -1,
+	                        self->cancellable,
+	                        set_device_alias_done,
+	                        self);
+}
+
+
 static void
 update_properties (BluetoothSettingsWidget *self,
 		   BluetoothDevice         *device)
@@ -1119,6 +1171,7 @@ update_properties (BluetoothSettingsWidget *self,
 
 	/* Name */
         gtk_label_set_label (GTK_LABEL (WID ("device_name")), alias);
+	gtk_editable_set_text (GTK_EDITABLE (WID ("device_alias")), alias);
 	g_free (self->selected_name);
 	self->selected_name = alias;
 
@@ -1589,6 +1642,8 @@ setup_properties_dialog (BluetoothSettingsWidget *self)
 {
 	self->properties_dialog = ADW_DIALOG (WID ("properties_dialog"));
 
+	g_signal_connect (G_OBJECT (WID ("save_device_alias")), "clicked",
+			  G_CALLBACK (save_device_alias), self);
 	g_signal_connect (G_OBJECT (WID ("delete_button_row")), "activated",
 			  G_CALLBACK (delete_callback), self);
 	g_signal_connect (G_OBJECT (WID ("mouse_button_row")), "activated",
diff --git a/lib/settings.ui b/lib/settings.ui
index 16d33ec..6b08eec 100644
--- a/lib/settings.ui
+++ b/lib/settings.ui
@@ -42,6 +42,23 @@
                 </child>
               </object>
             </child>
+            <child>
+              <object class="AdwPreferencesGroup">
+                <child>
+                  <object class="AdwEntryRow" id="device_alias">
+                    <property name="title" translatable="yes">Device _Name</property>
+                    <property name="use-underline">True</property>
+                    <child>
+                      <object class="GtkButton" id="save_device_alias">
+                        <property name="label" translatable="yes">_Save</property>
+                        <property name="use-underline">True</property>
+                        <property name="valign">center</property>
+                      </object>
+                    </child>
+                  </object>
+                </child>
+              </object>
+            </child>
             <child>
               <object class="AdwPreferencesGroup">
                 <child>
diff --git a/tests/integration-test.py b/tests/integration-test.py
index 6fc9a30..568704b 100755
--- a/tests/integration-test.py
+++ b/tests/integration-test.py
@@ -134,6 +134,22 @@ class OopTests(dbusmock.DBusTestCase):
         self.assertEqual(received_notification, True)
         self.assertEqual(device.props.connected, True)
 
+    def test_device_alias_changed(self):
+        bus = dbus.SystemBus()
+        device_path = '/org/bluez/hci0/dev_22_33_44_55_66_77'
+        properties = dbus.Interface(bus.get_object('org.bluez', device_path),
+                                    'org.freedesktop.DBus.Properties')
+
+        list_store = self.client.get_devices()
+        self.wait_for_condition(lambda: list_store.get_n_items() == 1)
+        device = list_store.get_item(0)
+        self.assertEqual(device.props.alias, 'My Mouse')
+
+        properties.Set('org.bluez.Device1', 'Alias',
+                       dbus.String('Desk Mouse', variant_level=1))
+        self.wait_for_condition(lambda: device.props.alias == 'Desk Mouse')
+        self.assertEqual(device.props.alias, 'Desk Mouse')
+
     def test_device_removal(self):
         bus = dbus.SystemBus()
         dbusmock_bluez = dbus.Interface(bus.get_object('org.bluez', '/'), 'org.bluez.Mock')
@@ -550,6 +566,11 @@ class Tests(dbusmock.DBusTestCase):
         self.dbusmock_bluez.AddDevice('hci0', '22:33:44:55:66:77', 'My Mouse')
         self.run_test_process()
 
+    def test_device_alias_changed(self):
+        self.dbusmock_bluez.AddAdapter('hci0', 'my-computer')
+        self.dbusmock_bluez.AddDevice('hci0', '22:33:44:55:66:77', 'My Mouse')
+        self.run_test_process()
+
     def test_device_removal(self):
         self.dbusmock_bluez.AddAdapter('hci0', 'my-computer')
         self.run_test_process()
-- 
2.53.0

