From d8ebd578b3a9cd960f1a5dbdb9169d5a1d0e9878 Mon Sep 17 00:00:00 2001
From: Daniel Nylander <yeager@users.noreply.gitlab.gnome.org>
Date: Sat, 12 Sep 2026 08:15:50 +0200
Subject: [PATCH] scores: create player cells during factory setup

---
 games/scores/dialog.vala | 117 ++++++++++++++++++++++-----------------
 1 file changed, 66 insertions(+), 51 deletions(-)

diff --git a/games/scores/dialog.vala b/games/scores/dialog.vala
index 83c0a3f..f9db43e 100644
--- a/games/scores/dialog.vala
+++ b/games/scores/dialog.vala
@@ -34,6 +34,27 @@ dialog.scores columnview row cell {
 }
 """;
 
+private class PlayerCell : Gtk.Box
+{
+    public Gtk.Inscription label { get; private set; }
+    public Gtk.Entry entry { get; private set; }
+    public Score? score { get; set; default = null; }
+    public bool binding { get; set; default = false; }
+
+    public PlayerCell ()
+    {
+        label = new Gtk.Inscription (null);
+        label.has_tooltip = true;
+        entry = new Gtk.Entry ();
+        entry.set_has_frame (false);
+        entry.add_css_class ("heading");
+
+        append (label);
+        append (entry);
+        entry.visible = false;
+    }
+}
+
 private class Dialog : Adw.Dialog
 {
     private Context context;
@@ -341,75 +362,69 @@ private class Dialog : Adw.Dialog
 
         factory.setup.connect ((factory, object) => {
             unowned var list_item = object as Gtk.ListItem;
+            var cell = new PlayerCell ();
+
+            cell.label.query_tooltip.connect ((x, y, keyboard_tooltip, tooltip) => {
+                unowned Score? score = cell.score;
+                if (score == null)
+                    return false;
+
+                tooltip.set_text ("%s\n%s\n%s".printf (
+                    score.user, score.get_user_extra_info (),
+                    new DateTime.from_unix_utc (score.time).format ("%x")
+                ));
+                return true;
+            });
+            cell.entry.notify["text"].connect (() => {
+                unowned Score? score = cell.score;
+                if (cell.binding || score == null)
+                    return;
 
-            var label = new Gtk.Inscription (null);
-            label.has_tooltip = true;
-
-            list_item.child = label;
+                context.update_score_name (score, active_category, cell.entry.get_text ());
+                score.user = cell.entry.get_text ();
+            });
+            cell.entry.activate.connect (() => {
+                if (new_game_button != null)
+                    new_game_button.activate ();
+                else
+                    trigger_close ();
+            });
+            list_item.child = cell;
         });
 
         factory.bind.connect ((factory, object) => {
             unowned var list_item = object as Gtk.ListItem;
             unowned var score = list_item.item as Score;
+            unowned var cell = list_item.child as PlayerCell;
 
+            cell.score = score;
             if (score == new_high_score)
             {
-                if (list_item.child is Gtk.Entry)
-                    return;
-
-                player_entry = new Gtk.Entry ();
-                player_entry.text = score.user;
-                player_entry.set_has_frame (false);
-                player_entry.add_css_class ("heading");
-                player_entry.notify["text"].connect (() => {
-                    context.update_score_name (score, active_category, player_entry.get_text ());
-                    score.user = player_entry.get_text ();
-                });
-                player_entry.activate.connect (() => {
-                    if (new_game_button != null)
-                        new_game_button.activate ();
-                    else
-                        trigger_close ();
-                });
-
-                list_item.child = player_entry;
+                cell.binding = true;
+                cell.entry.text = score.user;
+                cell.binding = false;
+                cell.label.visible = false;
+                cell.entry.visible = true;
+                player_entry = cell.entry;
             }
             else
             {
-                unowned var label = list_item.child as Gtk.Inscription;
-
-                label.text = score.user;
-                label.query_tooltip.connect ((x, y, keyboard_tooltip, tooltip) => {
-                    tooltip.set_text ("%s\n%s\n%s".printf (
-                        score.user, score.get_user_extra_info (), new DateTime.from_unix_utc (score.time).format ("%x")
-                    ));
-                    return true;
-                });
+                cell.label.text = score.user;
+                cell.label.visible = true;
+                cell.entry.visible = false;
             }
         });
-        if (new_high_score != null)
-        {
-            factory.unbind.connect ((factory, object) => {
-                unowned var list_item = object as Gtk.ListItem;
-                unowned var score = list_item.item as Score;
-
-                if (score == new_high_score)
-                    player_entry = null;
-            });
-        }
-
         factory.unbind.connect ((factory, object) => {
             unowned var list_item = object as Gtk.ListItem;
             unowned var score = list_item.item as Score;
+            unowned var cell = list_item.child as PlayerCell;
+
+            if (score == new_high_score)
+                player_entry = null;
 
-            if (score != new_high_score)
-                SignalHandler.disconnect_matched (list_item.child,
-                                                  SignalMatchType.ID,
-                                                  Signal.lookup ("query-tooltip", list_item.child.get_type ()),
-                                                  0,
-                                                  null,
-                                                  null,
-                                                  null);
+            cell.score = null;
+            cell.label.visible = true;
+            cell.entry.visible = false;
         });
 
         player_column = new Gtk.ColumnViewColumn (_("Player"), factory);
-- 
