From 6bf665a83b2efaab7128aaa0f4fdd26ccd2dfa68 Mon Sep 17 00:00:00 2001
From: Daniel Nylander <yeager@users.noreply.gitlab.gnome.org>
Date: Fri, 11 Sep 2026 22:39:19 +0200
Subject: [PATCH 1/2] cc: Mark control connection failed before ending stream

---
 src/cc/cc-ctrl.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/cc/cc-ctrl.c b/src/cc/cc-ctrl.c
index 09ceecd..1bf6374 100644
--- a/src/cc/cc-ctrl.c
+++ b/src/cc/cc-ctrl.c
@@ -542,8 +542,8 @@ cc_ctrl_close_connection (CcCtrl *ctrl, GError *error)
   if (ctrl->state == CC_CTRL_STATE_ERROR)
     return;
 
-  ctrl->closure->end_stream (ctrl->closure->userdata, error);
   ctrl->state = CC_CTRL_STATE_ERROR;
+  ctrl->closure->end_stream (ctrl->closure->userdata, error);
 }
 
 void
