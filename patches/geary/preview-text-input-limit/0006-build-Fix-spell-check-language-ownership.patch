From: Daniel Nylander <yeager@users.noreply.gitlab.gnome.org>
Date: Sat, 12 Sep 2026 08:58:22 +0200
Subject: [PATCH 6/6] build: Fix spell-check language ownership

---
 src/client/application/application-configuration.vala | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/client/application/application-configuration.vala b/src/client/application/application-configuration.vala
index e80fbd3..79c6571 100644
--- a/src/client/application/application-configuration.vala
+++ b/src/client/application/application-configuration.vala
@@ -249,10 +249,10 @@ public class Application.Configuration : Geary.BaseObject {
         GLib.Variant? value = this.settings.get_value(
             SPELL_CHECK_LANGUAGES
         ).get_maybe();
-        string[] langs = (value != null)
-            ? value.get_strv()
-            : Util.I18n.get_user_preferred_languages();
-        return langs;
+        if (value != null)
+            return value.get_strv();
+
+        return Util.I18n.get_user_preferred_languages();
     }
 
     /**
