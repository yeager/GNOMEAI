From 03d9515710bd075d24801e1f6c27d57d82b29b79 Mon Sep 17 00:00:00 2001
From: Daniel Nylander <yeager@users.noreply.gitlab.gnome.org>
Date: Sat, 12 Sep 2026 11:34:26 +0200
Subject: [PATCH 2/2] about: Use uname for the CPU architecture fallback

---
 panels/system/about/cc-about-page.c | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/panels/system/about/cc-about-page.c b/panels/system/about/cc-about-page.c
index fc086c337..5c6763427 100644
--- a/panels/system/about/cc-about-page.c
+++ b/panels/system/about/cc-about-page.c
@@ -48,6 +48,7 @@
 #include <gdk/gdk.h>
 
 #include <locale.h>
+#include <sys/utsname.h>
 
 struct _CcAboutPage {
     AdwNavigationPage parent_instance;
@@ -538,7 +539,12 @@ get_cpu_info_fallback (void)
             return g_steal_pointer (&model);
     }
 
-    return g_strdup (g_get_host_cpu_architecture ());
+    struct utsname utsname;
+
+    if (uname (&utsname) == 0)
+        return g_strdup (utsname.machine);
+
+    return g_strdup (_("Unknown"));
 }
 
 char *
