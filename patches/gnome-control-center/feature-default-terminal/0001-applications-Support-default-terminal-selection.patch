Subject: [PATCH 1/2] applications: Support default terminal selection

---
 panels/applications/cc-default-apps-row.c | 157 ++++++++++++++++++++--
 1 file changed, 146 insertions(+), 11 deletions(-)

diff --git a/panels/applications/cc-default-apps-row.c b/panels/applications/cc-default-apps-row.c
index 77d5d1d47..aa986c11f 100644
--- a/panels/applications/cc-default-apps-row.c
+++ b/panels/applications/cc-default-apps-row.c
@@ -18,6 +18,9 @@
