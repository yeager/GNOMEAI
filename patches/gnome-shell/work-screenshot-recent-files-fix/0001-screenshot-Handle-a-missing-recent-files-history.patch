From a3e0c420a7a66a13ce4c91fda653ee97288e82e6 Mon Sep 17 00:00:00 2001
From: Daniel Nylander <yeager@users.noreply.gitlab.gnome.org>
Date: Fri, 11 Sep 2026 19:52:52 +0200
Subject: [PATCH] screenshot: Handle a missing recent-files history

On a profile without recently-used.xbel, taking a screenshot saves the PNG
but does not add it to recent files. GLib.BookmarkFile.load_from_file()
reports a missing file as GLib.FileError.NOENT, while the handler checked
GLib.BookmarkFileError.FILE_NOT_FOUND and returned.

Fixes: b89d90eb80 ("screenshot: Use GLib.BookmarkFile to save recent screenshots")
---
 js/ui/screenshot.js | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/js/ui/screenshot.js b/js/ui/screenshot.js
index c6687cc..02560b9 100644
--- a/js/ui/screenshot.js
+++ b/js/ui/screenshot.js
@@ -2666,7 +2666,7 @@ function _storeScreenshot(bytes, pixbuf) {
         try {
             bookmarks.load_from_file(recentFile);
         } catch (e) {
-            if (!e.matches(GLib.BookmarkFileError, GLib.BookmarkFileError.FILE_NOT_FOUND)) {
+            if (!e.matches(GLib.FileError, GLib.FileError.NOENT)) {
                 log(`Could not open recent file ${uri}: ${e.message}`);
                 return;
             }
-- 
