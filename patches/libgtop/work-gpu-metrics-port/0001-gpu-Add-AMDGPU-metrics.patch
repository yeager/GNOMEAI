diff --git a/examples/gpu.c b/examples/gpu.c
new file mode 100644
index 00000000..d353ff86
--- /dev/null
+++ b/examples/gpu.c
@@ -0,0 +1,23 @@
+#include <glibtop.h>
+#include <glibtop/gpu.h>
+
+#include <stdio.h>
+
+int
+main (void)
+{
+	glibtop_gpu gpu;
+
+	glibtop_init ();
+	glibtop_get_gpu (&gpu);
+
+	for (guint64 i = 0; i < gpu.ngpu; i++) {
+		printf ("%" G_GUINT64_FORMAT "\t%s\tbusy: %" G_GUINT64_FORMAT
+		        "%%\tvram: %" G_GUINT64_FORMAT "/%" G_GUINT64_FORMAT " bytes\n",
+		        i, gpu.driver[i], gpu.xgpu_busy_percent[i],
+		        gpu.xgpu_vram_used[i], gpu.xgpu_vram_total[i]);
+	}
+
+	glibtop_close ();
+	return 0;
+}
