index 00000000..25365f5b
--- /dev/null
+++ b/include/glibtop/gpu.h
@@ -0,0 +1,67 @@
+/* Copyright (C) 2026
+ *
+ * This file is part of LibGTop.
+ *
+ * LibGTop is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#ifndef __GLIBTOP_GPU_H__
+#define __GLIBTOP_GPU_H__
+
+#include <glibtop.h>
+#include <glibtop/global.h>
+
+G_BEGIN_DECLS
+
+#define GLIBTOP_NGPU                 0
+#define GLIBTOP_XGPU_BUSY_PERCENT     1
+#define GLIBTOP_XGPU_GTT_TOTAL        2
+#define GLIBTOP_XGPU_GTT_USED         3
+#define GLIBTOP_XGPU_VIS_VRAM_TOTAL   4
+#define GLIBTOP_XGPU_VIS_VRAM_USED    5
+#define GLIBTOP_XGPU_VRAM_TOTAL       6
+#define GLIBTOP_XGPU_VRAM_USED        7
+
+#define GLIBTOP_MAX_GPU               16
+#define GLIBTOP_GPU_DRIVER_NAME_SIZE  16
+
+typedef struct _glibtop_gpu glibtop_gpu;
+
+struct _glibtop_gpu
+{
+	guint64 flags;
+	guint64 ngpu;
+	gchar driver[GLIBTOP_MAX_GPU][GLIBTOP_GPU_DRIVER_NAME_SIZE];
+	guint64 xgpu_busy_percent[GLIBTOP_MAX_GPU];
+	guint64 xgpu_gtt_total[GLIBTOP_MAX_GPU];
+	guint64 xgpu_gtt_used[GLIBTOP_MAX_GPU];
+	guint64 xgpu_vis_vram_total[GLIBTOP_MAX_GPU];
+	guint64 xgpu_vis_vram_used[GLIBTOP_MAX_GPU];
+	guint64 xgpu_vram_total[GLIBTOP_MAX_GPU];
+	guint64 xgpu_vram_used[GLIBTOP_MAX_GPU];
+};
+
+void glibtop_get_gpu (glibtop_gpu *buf);
+
+#if GLIBTOP_SUID_GPU
+#define glibtop_get_gpu_r glibtop_get_gpu_p
+#else
+#define glibtop_get_gpu_r glibtop_get_gpu_s
+#endif
+
+void glibtop_get_gpu_l (glibtop *server, glibtop_gpu *buf);
+
+#if GLIBTOP_SUID_GPU
+void _glibtop_init_gpu_p (glibtop *server);
+void glibtop_get_gpu_p (glibtop *server, glibtop_gpu *buf);
+#else
+void _glibtop_init_gpu_s (glibtop *server);
+void glibtop_get_gpu_s (glibtop *server, glibtop_gpu *buf);
+#endif
+
+G_END_DECLS
+
+#endif
