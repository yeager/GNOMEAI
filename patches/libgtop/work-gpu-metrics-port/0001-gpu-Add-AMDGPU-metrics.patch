diff --git a/sysdeps/linux/gpu.c b/sysdeps/linux/gpu.c
new file mode 100644
index 00000000..22231086
--- /dev/null
+++ b/sysdeps/linux/gpu.c
@@ -0,0 +1,131 @@
+/* Copyright (C) 2026
+ *
+ * This file is part of LibGTop.
+ *
+ * LibGTop is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU General Public License as published by
+ * the Free Software Foundation; either version 2 of the License, or
+ * (at your option) any later version.
+ */
+
+#include <config.h>
+#include <glibtop/gpu.h>
+
+#include <glib.h>
+
+#ifndef GLIBTOP_DRM_SYSFS_ROOT
+#define GLIBTOP_DRM_SYSFS_ROOT "/sys/class/drm"
+#endif
+#define AMDGPU_DRIVER "amdgpu"
+
+static const unsigned long _glibtop_sysdeps_gpu =
+	(1UL << GLIBTOP_NGPU) |
+	(1UL << GLIBTOP_XGPU_BUSY_PERCENT) |
+	(1UL << GLIBTOP_XGPU_GTT_TOTAL) |
+	(1UL << GLIBTOP_XGPU_GTT_USED) |
+	(1UL << GLIBTOP_XGPU_VIS_VRAM_TOTAL) |
+	(1UL << GLIBTOP_XGPU_VIS_VRAM_USED) |
+	(1UL << GLIBTOP_XGPU_VRAM_TOTAL) |
+	(1UL << GLIBTOP_XGPU_VRAM_USED);
+
+static gboolean
+read_metric (const gchar *card_path, const gchar *name, guint64 *value)
+{
+	g_autofree gchar *path = g_build_filename (card_path, "device", name, NULL);
+	g_autofree gchar *contents = NULL;
+
+	if (!g_file_get_contents (path, &contents, NULL, NULL))
+		return FALSE;
+
+	*value = g_ascii_strtoull (contents, NULL, 10);
+	return TRUE;
+}
+
+static gboolean
+is_amdgpu_card (const gchar *card_path)
+{
+	g_autofree gchar *path = g_build_filename (card_path, "device", "uevent", NULL);
+	g_autofree gchar *contents = NULL;
+	g_auto (GStrv) lines = NULL;
+
+	if (!g_file_get_contents (path, &contents, NULL, NULL))
+		return FALSE;
+
+	lines = g_strsplit (contents, "\n", -1);
+	for (guint i = 0; lines[i] != NULL; i++)
+		if (g_str_equal (lines[i], "DRIVER=" AMDGPU_DRIVER))
+			return TRUE;
+
+	return FALSE;
+}
+
+static gboolean
+is_card_name (const gchar *name)
+{
+	const gchar *suffix;
+
+	if (!g_str_has_prefix (name, "card"))
+		return FALSE;
+
+	suffix = name + strlen ("card");
+	return *suffix != '\0' && strspn (suffix, "0123456789") == strlen (suffix);
+}
+
+static void
+read_amdgpu_metrics (const gchar *card_path, glibtop_gpu *buf, guint index)
+{
+	if (read_metric (card_path, "gpu_busy_percent", &buf->xgpu_busy_percent[index]))
+		buf->flags |= 1UL << GLIBTOP_XGPU_BUSY_PERCENT;
+	if (read_metric (card_path, "mem_info_gtt_total", &buf->xgpu_gtt_total[index]))
+		buf->flags |= 1UL << GLIBTOP_XGPU_GTT_TOTAL;
+	if (read_metric (card_path, "mem_info_gtt_used", &buf->xgpu_gtt_used[index]))
+		buf->flags |= 1UL << GLIBTOP_XGPU_GTT_USED;
+	if (read_metric (card_path, "mem_info_vis_vram_total", &buf->xgpu_vis_vram_total[index]))
+		buf->flags |= 1UL << GLIBTOP_XGPU_VIS_VRAM_TOTAL;
+	if (read_metric (card_path, "mem_info_vis_vram_used", &buf->xgpu_vis_vram_used[index]))
+		buf->flags |= 1UL << GLIBTOP_XGPU_VIS_VRAM_USED;
+	if (read_metric (card_path, "mem_info_vram_total", &buf->xgpu_vram_total[index]))
+		buf->flags |= 1UL << GLIBTOP_XGPU_VRAM_TOTAL;
+	if (read_metric (card_path, "mem_info_vram_used", &buf->xgpu_vram_used[index]))
+		buf->flags |= 1UL << GLIBTOP_XGPU_VRAM_USED;
+}
+
+void
+_glibtop_init_gpu_s (glibtop *server)
+{
+	server->sysdeps.gpu = _glibtop_sysdeps_gpu;
+}
+
+void
+glibtop_get_gpu_s (glibtop *server, glibtop_gpu *buf)
+{
+	const gchar *name;
+	GDir *dir;
+
+	(void) server;
+	memset (buf, 0, sizeof (*buf));
+
+	dir = g_dir_open (GLIBTOP_DRM_SYSFS_ROOT, 0, NULL);
+	if (dir == NULL)
+		return;
+
+	while (buf->ngpu < GLIBTOP_MAX_GPU && (name = g_dir_read_name (dir)) != NULL) {
+		g_autofree gchar *card_path = NULL;
+		guint index;
+
+		if (!is_card_name (name))
+			continue;
+
+		card_path = g_build_filename (GLIBTOP_DRM_SYSFS_ROOT, name, NULL);
+		if (!is_amdgpu_card (card_path))
+			continue;
+
+		index = buf->ngpu++;
+		g_strlcpy (buf->driver[index], AMDGPU_DRIVER, sizeof (buf->driver[index]));
+		read_amdgpu_metrics (card_path, buf, index);
+	}
+
+	g_dir_close (dir);
+	if (buf->ngpu > 0)
+		buf->flags |= 1UL << GLIBTOP_NGPU;
+}
