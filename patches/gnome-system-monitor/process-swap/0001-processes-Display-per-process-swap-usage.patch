From 1a97ed0b53dcd811d454e71a9410ba20be63ec19 Mon Sep 17 00:00:00 2001
From: yeager <yeager@users.noreply.github.com>
Date: Sat, 12 Sep 2026 14:37:13 +0200
Subject: [PATCH] processes: Display per-process swap usage

---
 src/procinfo.h    |  2 ++
 src/proctable.cpp | 37 +++++++++++++++++++++++++++++++++++++
 src/proctable.h   |  1 +
 3 files changed, 40 insertions(+)

diff --git a/src/procinfo.h b/src/procinfo.h
index 8f2826c..433fac0 100644
--- a/src/procinfo.h
+++ b/src/procinfo.h
@@ -20,6 +20,7 @@ struct MutableProcInfo
     : vmsize (0UL),
     memres (0UL),
     memshared (0UL),
+    memswap (0UL),
     memwritable (0UL),
     mem (0UL),
     start_time (0UL),
@@ -45,6 +46,7 @@ struct MutableProcInfo
   gulong vmsize;
   gulong memres;
   gulong memshared;
+  gulong memswap;
   gulong memwritable;
   gulong mem;
 
diff --git a/src/proctable.cpp b/src/proctable.cpp
index 8f99114..8f01dac 100644
--- a/src/proctable.cpp
+++ b/src/proctable.cpp
@@ -345,6 +345,7 @@ proctable_new (GsmApplication * const app)
     N_("Resident Memory"),
     N_("Writable Memory"),
     N_("Shared Memory"),
+    N_("Swap Memory"),
     N_("X Server Memory"),
     /* xgettext:no-c-format */ N_("CPU"),
     N_("CPU Time"),
@@ -382,6 +383,7 @@ proctable_new (GsmApplication * const app)
                               G_TYPE_ULONG,         /* Resident Memory */
                               G_TYPE_ULONG,         /* Writable Memory */
                               G_TYPE_ULONG,         /* Shared Memory */
+                              G_TYPE_ULONG,         /* Swap Memory */
                               G_TYPE_ULONG,         /* X Server Memory */
                               G_TYPE_DOUBLE,        /* % CPU        */
                               G_TYPE_UINT64,        /* CPU time     */
@@ -499,6 +501,7 @@ proctable_new (GsmApplication * const app)
           case COL_VMSIZE:
           case COL_MEMRES:
           case COL_MEMSHARED:
+          case COL_MEMSWAP:
           case COL_MEM:
             gtk_tree_view_column_set_cell_data_func (col, cell,
                                                      &procman::size_na_cell_data_func,
@@ -570,6 +573,7 @@ proctable_new (GsmApplication * const app)
           case COL_VMSIZE:
           case COL_MEMRES:
           case COL_MEMSHARED:
+          case COL_MEMSWAP:
           case COL_MEM:
           case COL_CPU:
           case COL_CPU_TIME:
@@ -595,6 +599,7 @@ proctable_new (GsmApplication * const app)
           case COL_VMSIZE:
           case COL_MEMRES:
           case COL_MEMSHARED:
+          case COL_MEMSWAP:
           case COL_MEM:
           case COL_CPU:
           case COL_CPU_TIME:
@@ -625,6 +630,7 @@ proctable_new (GsmApplication * const app)
           case COL_VMSIZE:
           case COL_MEMRES:
           case COL_MEMSHARED:
+          case COL_MEMSWAP:
           case COL_CPU:
           case COL_NICE:
           case COL_PID:
@@ -748,6 +754,29 @@ get_process_memory_writable (ProcInfo *info)
   g_free (maps);
 }
 
+static gulong
+get_process_swap (pid_t pid)
+{
+  g_autofree char *contents = NULL;
+  g_autofree char *path = g_strdup_printf ("/proc/%d/status", pid);
+  const char *line;
+  guint64 kibibytes;
+
+  if (!g_file_get_contents (path, &contents, NULL, NULL))
+    return 0;
+
+  line = g_strstr_len (contents, -1, "\nVmSwap:");
+  if (line == NULL)
+    return 0;
+
+  line += strlen ("\nVmSwap:");
+  while (g_ascii_isspace (*line))
+    line++;
+
+  kibibytes = g_ascii_strtoull (line, NULL, 10);
+  return MIN (kibibytes, G_MAXULONG / 1024) * 1024;
+}
+
 static void
 get_process_memory_info (ProcInfo *info)
 {
@@ -758,6 +787,7 @@ get_process_memory_info (ProcInfo *info)
   info->vmsize = procmem.vsize;
   info->memres = procmem.resident;
   info->memshared = procmem.share;
+  info->memswap = get_process_swap (info->pid);
 
   info->mem = info->memres - info->memshared;
 }
@@ -778,6 +808,7 @@ update_info_mutable_cols (ProcInfo *info)
   tree_store_update (model, &info->node, COL_VMSIZE, info->vmsize);
   tree_store_update (model, &info->node, COL_MEMRES, info->memres);
   tree_store_update (model, &info->node, COL_MEMSHARED, info->memshared);
+  tree_store_update (model, &info->node, COL_MEMSWAP, info->memswap);
   tree_store_update (model, &info->node, COL_CPU, info->pcpu);
   tree_store_update (model, &info->node, COL_CPU_TIME, info->cpu_time);
   tree_store_update (model, &info->node, COL_DISK_READ_TOTAL, info->disk_read_bytes_total);
@@ -987,6 +1018,7 @@ proctable_refresh_summary_headers(GsmApplication * app)
   uint64_t total_memres = 0;
   uint64_t total_vmsize = 0;
   uint64_t total_memshared = 0;
+  uint64_t total_memswap = 0;
   uint64_t total_memwritable = 0;
   uint64_t total_disk_read_bytes_total = 0;
   uint64_t total_disk_write_bytes_total = 0;
@@ -1042,6 +1074,7 @@ proctable_refresh_summary_headers(GsmApplication * app)
                   &total_vmsize,
                   &total_memres,
                   &total_memshared,
+                  &total_memswap,
                   &total_memwritable,
                   &total_disk_read_bytes_total,
                   &total_disk_write_bytes_total,
@@ -1063,6 +1096,7 @@ proctable_refresh_summary_headers(GsmApplication * app)
     total_memres += proc->memres;
     total_vmsize += proc->vmsize;
     total_memshared += proc->memshared;
+    total_memswap += proc->memswap;
     total_memwritable += proc->memwritable;
     total_disk_read_bytes_total += proc->disk_read_bytes_total;
     total_disk_write_bytes_total += proc->disk_write_bytes_total;
@@ -1120,6 +1154,9 @@ proctable_refresh_summary_headers(GsmApplication * app)
     case COL_MEMSHARED:
       v_str = format_bytes(total_memshared);
       break;
+    case COL_MEMSWAP:
+      v_str = format_bytes(total_memswap);
+      break;
     case COL_DISK_READ_TOTAL:
       v_str = format_bytes(total_disk_read_bytes_total);
       break;
diff --git a/src/proctable.h b/src/proctable.h
index 62811da..03ff6e7 100644
--- a/src/proctable.h
+++ b/src/proctable.h
@@ -34,6 +34,7 @@ enum
   COL_MEMRES,
   COL_MEMWRITABLE,
   COL_MEMSHARED,
+  COL_MEMSWAP,
   COL_MEMXSERVER,
   COL_CPU,
   COL_CPU_TIME,
