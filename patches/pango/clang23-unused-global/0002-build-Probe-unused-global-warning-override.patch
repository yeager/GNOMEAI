From 0eef67d3c1d38f09d2987e5f5935f30642dc6c2b Mon Sep 17 00:00:00 2001
From: Daniel Nylander <yeager@users.noreply.gitlab.gnome.org>
Date: Sat, 12 Sep 2026 10:37:21 +0200
Subject: [PATCH 2/3] build: Probe unused global warning override

---
 meson.build | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/meson.build b/meson.build
index 58faa84..f396b57 100644
--- a/meson.build
+++ b/meson.build
@@ -148,10 +148,13 @@ elif cc.get_id() == 'gcc' or cc.get_id() == 'clang'
     '-Werror=empty-body',
     '-Werror=write-strings',
     '-Werror=unused-but-set-variable',
-    '-Wno-error=unused-but-set-global',
     '-Wundef', # FIXME: https://bugzilla.gnome.org/show_bug.cgi?id=792481
   ]
 
+  test_cflags += cc.get_supported_arguments([
+    '-Wno-error=unused-but-set-global',
+  ])
+
   if host_system == 'windows'
     test_cflags += [ '-mms-bitfields' ]
   else
-- 
